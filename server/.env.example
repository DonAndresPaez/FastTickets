# Copy this to .env and fill in your own values (.env is not committed)

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Signs login cookies. Any long random string, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Email for login codes. Leave SMTP_HOST unset in development to get a free
# temporary Ethereal inbox; the server logs a link to view each email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=FastTickets <no-reply@fasttickets.local>

# PostgreSQL, use the password you set when installing it
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=fasttickets

# Optional, overrides the PG* values above (e.g. a hosted database)
# DATABASE_URL=postgresql://user:password@host:5432/fasttickets
# PGSSL=true
